# Solace - en_US.lang
# Names and tooltips for the options in lib/config.glsl.

option.WATER_WAVES=Water waves
option.WATER_WAVES.comment=Animated normals on the water surface. Two noise layers, cheap, but not free.
value.WATER_WAVES.0=Off
value.WATER_WAVES.1=On

option.WAVE_SPEED=Wave speed
option.WAVE_SPEED.comment=How fast the water surface moves.

option.WAVE_SCALE=Wave scale
option.WAVE_SCALE.comment=Size of the wave pattern. Larger values give smaller, busier waves.

option.WATER_OPACITY=Water opacity
option.WATER_OPACITY.comment=How much of the bottom shows through the water. Higher is more solid.

option.WATER_REFLECTION=Water reflection
option.WATER_REFLECTION.comment=Paints the sky onto the water surface, stronger at shallow angles.
value.WATER_REFLECTION.0=Off
value.WATER_REFLECTION.1=On

option.WATER_GLINT=Sun glint
option.WATER_GLINT.comment=Highlight where the sun or moon reflects off the water.
value.WATER_GLINT.0=Off
value.WATER_GLINT.1=On

option.FOG_DENSITY=Fog density
option.FOG_DENSITY.comment=How quickly the world fades into the sky colour with distance.

option.UNDERWATER_FOG=Underwater fog
option.UNDERWATER_FOG.comment=Dense blue-green fog while the camera is in water.
value.UNDERWATER_FOG.0=Off
value.UNDERWATER_FOG.1=On

option.SUN_SHADING=Sun shading
option.SUN_SHADING.comment=Adds a directional sun term to lit surfaces. There is no shadow map in this pack, so skylight still decides what is lit.
value.SUN_SHADING.0=Off
value.SUN_SHADING.1=On

option.BLOCK_LIGHT=Torch light
option.BLOCK_LIGHT.comment=Strength of torch, lava and other block light.

option.BLOCKLIGHT_TEMP=Torch light colour
option.BLOCKLIGHT_TEMP.comment=Temperature of torch and lava light, from deep orange to neutral white.
value.BLOCKLIGHT_TEMP.0=Orange
value.BLOCKLIGHT_TEMP.1=Amber
value.BLOCKLIGHT_TEMP.2=Warm white
value.BLOCKLIGHT_TEMP.3=Cream
value.BLOCKLIGHT_TEMP.4=Neutral

option.NIGHT_AMBIENT=Night brightness
option.NIGHT_AMBIENT.comment=How much light the night sky gives.

option.EYE_LIGHT=Night vision
option.EYE_LIGHT.comment=Let the vanilla night vision effect add light.
value.EYE_LIGHT.0=Off
value.EYE_LIGHT.1=On

option.SKY_SUN_GLOW=Sun halo
option.SKY_SUN_GLOW.comment=Glow around the sun and the moon.
value.SKY_SUN_GLOW.0=Off
value.SKY_SUN_GLOW.1=On

option.SKY_STARS=Stars
option.SKY_STARS.comment=Stars at night.
value.SKY_STARS.0=Off
value.SKY_STARS.1=On

option.SUN_PATH=Sun path
option.SUN_PATH.comment=How far the sun's arc tilts across the sky. This is what makes sunrises and sunsets swing round through the year instead of every day crossing overhead.
value.SUN_PATH.-40=-40 degrees
value.SUN_PATH.-30=-30 degrees
value.SUN_PATH.-25=-25 degrees
value.SUN_PATH.-20=-20 degrees
value.SUN_PATH.-10=-10 degrees
value.SUN_PATH.0=Overhead
value.SUN_PATH.10=10 degrees
value.SUN_PATH.20=20 degrees
value.SUN_PATH.25=25 degrees
value.SUN_PATH.30=30 degrees
value.SUN_PATH.40=40 degrees

option.SUN_SIZE=Sun size
option.SUN_SIZE.comment=How large the sun, the moon and their haloes read. Larger values widen the glow as well as the disc.
value.SUN_SIZE.0.7=Small
value.SUN_SIZE.1.0=Normal
value.SUN_SIZE.1.3=Large
value.SUN_SIZE.1.8=Huge

option.SUN_HALO_SHAPE=Sun shape
option.SUN_HALO_SHAPE.comment=The shape of the light around the sun: a hard point, a soft glow, or a wide haze across the sky.
value.SUN_HALO_SHAPE.0=Hard point
value.SUN_HALO_SHAPE.1=Soft glow
value.SUN_HALO_SHAPE.2=Wide haze

option.SUN_R=Sunlight red
option.SUN_R.comment=Red gain of direct sunlight, in percent. The three sun channels are separate from the three output channels so the sky can be corrected without touching the whole picture.
option.SUN_G=Sunlight green
option.SUN_G.comment=Green gain of direct sunlight, in percent. Lower it if the sun reads too green.
option.SUN_B=Sunlight blue
option.SUN_B.comment=Blue gain of direct sunlight, in percent. Raise it for a cooler, whiter sun.

option.V_CLOUDS=Volumetric clouds
option.V_CLOUDS.comment=A slab of procedural cloud marched in the sky pass. No texture, but several noise samples per sky pixel.
value.V_CLOUDS.0=Off
value.V_CLOUDS.1=On

option.CLOUD_STYLE=Cloud style
option.CLOUD_STYLE.comment=What the cloud deck is made of. Natural is soft noise, blocky quantises it into plates, pack texture reads textures/noise.png instead of computing it, and vanilla leaves the clouds to the game.
value.CLOUD_STYLE.0=Natural
value.CLOUD_STYLE.1=Blocky
value.CLOUD_STYLE.2=Pack texture
value.CLOUD_STYLE.3=Vanilla

option.CLOUD_SPEED=Cloud speed
option.CLOUD_SPEED.comment=How fast the deck drifts, as a multiple of the pack's normal speed. Zero freezes it into a still landscape.
value.CLOUD_SPEED.0.0=Still
value.CLOUD_SPEED.0.5=Slow
value.CLOUD_SPEED.1.0=Normal
value.CLOUD_SPEED.2.0=Fast

option.CLOUD_STEPS=Cloud samples
option.CLOUD_STEPS.comment=Samples taken through the cloud slab. The main cost of the effect.

option.CLOUD_COVERAGE=Cloud coverage
option.CLOUD_COVERAGE.comment=How much of the sky the clouds fill.

option.EXPOSURE=Exposure
option.EXPOSURE.comment=Overall brightness before the tone curve.

option.SATURATION=Saturation
option.SATURATION.comment=Colour strength. 1.0 leaves the image as it is.

option.CONTRAST=Contrast
option.CONTRAST.comment=Pushes darks and lights apart around mid grey.

option.TONEMAP=Tone curve
option.TONEMAP.comment=How bright values are rolled into the screen range.
value.TONEMAP.0=Clamp
value.TONEMAP.1=Soft
value.TONEMAP.2=Gentle

option.DITHER=Dither
option.DITHER.comment=A sub-pixel of noise that hides banding in the sky gradient.
value.DITHER.0=Off
value.DITHER.1=On

option.SHADOWS=Cast shadows
option.SHADOWS.comment=A second scene render into a shadow map, sized by the shadow quality and distance sliders below. The most expensive thing this pack can do, so it is off: measure it before keeping it on.
value.SHADOWS.0=Off
value.SHADOWS.1=On

option.WAVING=Plant waving
option.WAVING.comment=Sways grass, ferns, flowers, crops, saplings and leaves. Uses the ids in block.properties.
value.WAVING.0=Off
value.WAVING.1=On

option.WAVE_STRENGTH=Waving strength
option.WAVE_STRENGTH.comment=How far plants lean. Vertex work on every plant, so it is the first thing to lower.

option.HAND_LIGHT=Held torch light
option.HAND_LIGHT.comment=A torch, lantern or lava bucket in your hand lights the surfaces within six blocks.
value.HAND_LIGHT.0=Off
value.HAND_LIGHT.1=On

option.ENTITY_TINT=Damage tint
option.ENTITY_TINT.comment=Keeps the red flash on a mob you just hit.
value.ENTITY_TINT.0=Off
value.ENTITY_TINT.1=On

option.SHADOW_SOFT=Soft shadows
option.SHADOW_SOFT.comment=Four-tap filtered shadow lookup instead of one hard tap. Ignores the shadow option being off.
value.SHADOW_SOFT.0=Hard
value.SHADOW_SOFT.1=Soft

option.AO=Ambient occlusion
option.AO.comment=Screen-space occlusion from the depth buffer, applied in the final pass. Six taps per pixel, so measure it.
value.AO.0=Off
value.AO.1=On

option.AO_STRENGTH=AO strength
option.AO_STRENGTH.comment=How dark the corners get.

option.AO_RADIUS=AO radius
option.AO_RADIUS.comment=How far the occlusion reaches. Larger values are softer and cheaper to look at.

option.BLOOM=Bloom
option.BLOOM.comment=Bright-pass glow in the final pass. Eight taps per pixel.
value.BLOOM.0=Off
value.BLOOM.1=On

option.BLOOM_STRENGTH=Bloom strength
option.BLOOM_STRENGTH.comment=How much glow is added back.

option.BLOOM_RADIUS=Bloom radius
option.BLOOM_RADIUS.comment=How far the glow spreads.

option.CHROMA_ABER=Chromatic aberration
option.CHROMA_ABER.comment=Splits red and blue towards the edges of the screen.
value.CHROMA_ABER.0=Off
value.CHROMA_ABER.1=On

option.CHROMA_STRENGTH=Aberration strength
option.CHROMA_STRENGTH.comment=How far red and blue separate.

option.IMAGE_SHARPENING=Sharpening
option.IMAGE_SHARPENING.comment=Unsharp mask against the four neighbouring pixels.
value.IMAGE_SHARPENING.0=Off
value.IMAGE_SHARPENING.1=On

option.SHARPEN=Sharpening amount
option.SHARPEN.comment=How strong the unsharp mask is.

option.COLOR_BLINDNESS=Colour-blindness aid
option.COLOR_BLINDNESS.comment=Pulls the picture towards the channels one kind of colour weakness still separates.
value.COLOR_BLINDNESS.0=Off
value.COLOR_BLINDNESS.1=On

option.COLOR_BLIND_MODE=Aid mode
option.COLOR_BLIND_MODE.comment=Which weakness to help with.
value.COLOR_BLIND_MODE.0=None
value.COLOR_BLIND_MODE.1=Red-weak
value.COLOR_BLIND_MODE.2=Green-weak
value.COLOR_BLIND_MODE.3=Blue-weak


option.REFRACTION=Water refraction
option.REFRACTION.comment=Bends what is behind the water. Needs a copy of the scene, so it costs a full-screen pass.
value.REFRACTION.0=Off
value.REFRACTION.1=On

option.WATER_ABSORPTION=Water absorption
option.WATER_ABSORPTION.comment=How fast light dies as it travels through water. Only used with refraction on.

option.V_CLOUDS=Volumetric clouds
option.V_CLOUDS.comment=A slab of procedural cloud marched in the sky pass. No texture, but several noise samples per sky pixel.
value.V_CLOUDS.0=Off
value.V_CLOUDS.1=On

option.CLOUD_STEPS=Cloud samples
option.CLOUD_STEPS.comment=Samples taken through the cloud slab. The main cost of the effect.

option.CLOUD_COVERAGE=Cloud coverage
option.CLOUD_COVERAGE.comment=How much of the sky the clouds fill.

option.DOF=Depth of field
option.DOF.comment=Blurs away from the block in the centre of the screen.
value.DOF.0=Off
value.DOF.1=On

option.DOF_STRENGTH=Depth of field strength
option.DOF_STRENGTH.comment=How quickly the blur grows away from the focus plane.

option.AA_TYPE=Antialiasing
option.AA_TYPE.comment=Temporal uses a history buffer and a sub-pixel jitter. FXAA blends along detected edges. Both together give the cleanest edges.
value.AA_TYPE.0=Off
value.AA_TYPE.1=Temporal
value.AA_TYPE.2=Temporal + FXAA
value.AA_TYPE.3=FXAA only

option.TAA_WEIGHT=Temporal blend
option.TAA_WEIGHT.comment=How much of the previous frame survives. Higher is smoother and can ghost.

option.FXAA_EDGE=FXAA threshold
option.FXAA_EDGE.comment=How much contrast counts as an edge. Lower blurs more.

option.MOTION_BLUR=Motion blur
option.MOTION_BLUR.comment=Blurs along the path the camera moved since the last frame.
value.MOTION_BLUR.0=Off
value.MOTION_BLUR.1=On

option.MOTION_BLUR_SAMPLES=Motion blur samples
option.MOTION_BLUR_SAMPLES.comment=Samples along the path.

option.MOTION_BLUR_STRENGTH=Motion blur strength
option.MOTION_BLUR_STRENGTH.comment=How far the blur reaches. Lower it when the framerate is low.

option.AUTO_EXPOSURE=Auto exposure
option.AUTO_EXPOSURE.comment=Adapts the exposure to the brightness of the scene and smooths it over frames.
value.AUTO_EXPOSURE.0=Off
value.AUTO_EXPOSURE.1=On

option.AUTO_EXPOSURE_SPEED=Exposure speed
option.AUTO_EXPOSURE_SPEED.comment=How fast the exposure follows the scene.

option.VOL_LIGHT=Light shafts
option.VOL_LIGHT.comment=Marks how much open sky lies between a surface and the sun, and adds sunlight there.
value.VOL_LIGHT.0=Off
value.VOL_LIGHT.1=On

option.VOL_LIGHT_SAMPLES=Shaft samples
option.VOL_LIGHT_SAMPLES.comment=Steps taken towards the sun. The main cost of the effect.

option.VOL_LIGHT_STRENGTH=Light shaft strength
option.VOL_LIGHT_STRENGTH.comment=How much sunlight is added.


option.WATER_SSR=Water reflections
option.WATER_SSR.comment=Marchers the reflected ray through the scene copy, so water reflects the world and not only the sky. Costs one march per water pixel.
value.WATER_SSR.0=Off
value.WATER_SSR.1=On

option.SSR_STEPS=Reflection steps
option.SSR_STEPS.comment=Steps of that march. More steps reach further.

option.WATER_TEXTURE=Water texture
option.WATER_TEXTURE.comment=Use the resource pack's water texture as the base colour.
value.WATER_TEXTURE.0=Off
value.WATER_TEXTURE.1=On

option.VANILLA_WATER=Vanilla water colour
option.VANILLA_WATER.comment=Use vanilla's biome water colour alone, without the pack's tint.
value.VANILLA_WATER.0=Off
value.VANILLA_WATER.1=On

option.MATERIAL_GLOSS=Material gloss
option.MATERIAL_GLOSS.comment=A highlight on metal, polished blocks and fabric, from the ids in block.properties.
value.MATERIAL_GLOSS.0=Off
value.MATERIAL_GLOSS.1=On

option.GLOSS_STRENGTH=Gloss strength
option.GLOSS_STRENGTH.comment=How bright the material highlight is.

option.SHADOW_QTY_SLIDER=Shadow quality
option.SHADOW_QTY_SLIDER.comment=Shadow map resolution. Only used when cast shadows are on.

option.SHADOW_DISTANCE_SLIDER=Shadow distance
option.SHADOW_DISTANCE_SLIDER.comment=How far shadows reach. Only used when cast shadows are on.

option.SHADOW_BLUR=Shadow softness
option.SHADOW_BLUR.comment=How far the shadow taps spread.

option.COLOR_SCHEME=Colour preset
option.COLOR_SCHEME.comment=The sky and light palette. The presets are named for what they look like; Custom uses the channels on the palette screen.
value.COLOR_SCHEME.0=Natural
value.COLOR_SCHEME.1=Vivid
value.COLOR_SCHEME.2=Game
value.COLOR_SCHEME.3=Soft
value.COLOR_SCHEME.4=Cinematic
value.COLOR_SCHEME.5=Neon
value.COLOR_SCHEME.6=Warm
value.COLOR_SCHEME.7=Bright
value.COLOR_SCHEME.99=Custom

option.CUSTOM_ZENITH_R=Custom zenith red
option.CUSTOM_ZENITH_R.comment=Red of the custom sky colour overhead.
option.CUSTOM_ZENITH_G=Custom zenith green
option.CUSTOM_ZENITH_G.comment=Green of the custom sky colour overhead.
option.CUSTOM_ZENITH_B=Custom zenith blue
option.CUSTOM_ZENITH_B.comment=Blue of the custom sky colour overhead.
option.CUSTOM_HORIZON_R=Custom horizon red
option.CUSTOM_HORIZON_R.comment=Red of the custom sky colour at the horizon.
option.CUSTOM_HORIZON_G=Custom horizon green
option.CUSTOM_HORIZON_G.comment=Green of the custom sky colour at the horizon.
option.CUSTOM_HORIZON_B=Custom horizon blue
option.CUSTOM_HORIZON_B.comment=Blue of the custom sky colour at the horizon.
option.CUSTOM_AMBIENT=Custom sky light
option.CUSTOM_AMBIENT.comment=How much light the custom theme's sky gives. The eight presets set their own.
option.CUSTOM_WATER_R=Custom water red
option.CUSTOM_WATER_R.comment=Red of the water colour of the custom theme.
option.CUSTOM_WATER_G=Custom water green
option.CUSTOM_WATER_G.comment=Green of the water colour of the custom theme.
option.CUSTOM_WATER_B=Custom water blue
option.CUSTOM_WATER_B.comment=Blue of the water colour of the custom theme.


option.NV_COLOR_R=Night vision red
option.NV_COLOR_R.comment=Red of the tint night vision puts over the picture.
option.NV_COLOR_G=Night vision green
option.NV_COLOR_G.comment=Green of the tint night vision puts over the picture.
option.NV_COLOR_B=Night vision blue
option.NV_COLOR_B.comment=Blue of the tint night vision puts over the picture.

option.EMISSIVE_GLOW=Emissive blocks
option.EMISSIVE_GLOW.comment=Glowstone, lava, lanterns and the rest are never dimmed by the light level around them.
value.EMISSIVE_GLOW.0=Off
value.EMISSIVE_GLOW.1=On

option.BLACK_ENTITY_FIX=Black entity fix
option.BLACK_ENTITY_FIX.comment=Some old drivers draw entities pure black. This lifts black geometry to a floor so they are visible again. It is a workaround, not an effect: leave it off unless you have the bug.
value.BLACK_ENTITY_FIX.0=Off
value.BLACK_ENTITY_FIX.1=On (workaround)

option.AO_TAPS=Occlusion samples
option.AO_TAPS.comment=Ring samples for the ambient occlusion. Four is the cheap setting that keeps the effect on.
value.AO_TAPS.4=Four
value.AO_TAPS.6=Six

option.DOF_SAMPLES=Focus samples
option.DOF_SAMPLES.comment=Samples in the depth-of-field blur ring.

profile.Potato=Potato - highest frame rate
profile.Smooth=Smooth - high frame rate
profile.HD=HD - medium frame rate
profile.HDR=HDR - low frame rate
profile.Everything=Everything - every effect


# Pack textures and the two shadow options.
option.PACK_TEXTURES=Water ripple texture
option.PACK_TEXTURES.comment=Read the ripple field from textures/noise.png instead of computing it in the shader. Run textures/generate_textures.py once to create that file. The cloud texture is chosen by the cloud style instead.
value.PACK_TEXTURES.0=Computed
value.PACK_TEXTURES.1=From file

option.COLORED_SHADOW=Coloured shadows
option.COLORED_SHADOW.comment=Tint a shadow with the colour of the glass or water the light passed through. Only does anything with cast shadows on.
value.COLORED_SHADOW.0=Off
value.COLORED_SHADOW.1=On

option.SHADOW_LOCK=Shadow refresh
option.SHADOW_LOCK.comment=Redraw the shadow map every N frames instead of every frame. 0 is every frame, 64 costs a sixty-fourth of the shadow pass.


# Four options that had been added to the screen without a name here.
option.CLOUD_HEIGHT=Cloud height
option.CLOUD_HEIGHT.comment=Height of the cloud slab in blocks. Only used when volumetric clouds are on.

option.CLOUD_THICKNESS=Cloud thickness
option.CLOUD_THICKNESS.comment=Thickness of the cloud slab. A thicker slab reads darker from below.

option.BLOOM_LOD=Bloom spread
option.BLOOM_LOD.comment=How wide the glow spreads. Higher values reach further and read softer.

option.AO_FADE=Occlusion distance
option.AO_FADE.comment=Distance at which the ambient occlusion fades out.


option.AVOID_DARK_LEVEL=Cave light floor
option.AVOID_DARK_LEVEL.comment=The least light a cave or a moonless night gets. Raise it if the dark becomes a black screen on your monitor.


# Channel gains and gamma: the two things a monitor needs and a shader cannot guess.
option.COLOR_R=Red gain
option.COLOR_R.comment=Red channel gain, in percent. Lower it if your display runs warm.
option.COLOR_G=Green gain
option.COLOR_G.comment=Green channel gain, in percent.
option.COLOR_B=Blue gain
option.COLOR_B.comment=Blue channel gain, in percent. Raise it a little if the picture looks yellow.
option.GAMMA=Gamma
option.GAMMA.comment=Output gamma, in percent. Above 100 lifts the midtones without moving black or white - the control to raise on a dim laptop panel.


# The profiles themselves are named further up this file.
